<svg xmlns="http://www.w3.org/2000/svg"
     viewBox="0 0 262 391"
     width="262"
     height="391">

  <defs>
    <linearGradient id="shimmer" x1="-100%" y1="0" x2="100%" y2="0">
      <stop offset="0%" stop-color="#f1f1f1"/>
      <stop offset="50%" stop-color="#ffffff"/>
      <stop offset="100%" stop-color="#f1f1f1"/>

      <animateTransform
        attributeName="gradientTransform"
        type="translate"
        from="-1 0"
        to="1 0"
        dur="1.2s"
        repeatCount="indefinite"/>
    </linearGradient>
  </defs>

  <!-- Card -->
  <rect x="1" y="1" width="260" height="389" rx="14" fill="#fff" stroke="#e5e5e5"/>

  <!-- Foto -->
  <rect x="10" y="14"
        width="242"
        height="242"
        rx="12"
        fill="url(#shimmer)"/>

  <!-- Nome do produto -->
  <rect x="22"
        y="274"
        width="180"
        height="18"
        rx="4"
        fill="url(#shimmer)"/>

  <!-- Preço -->
  <rect x="22"
        y="304"
        width="100"
        height="28"
        rx="6"
        fill="url(#shimmer)"/>

  <!-- Botão Comprar -->
  <rect x="22"
        y="338"
        width="104"
        height="42"
        rx="8"
        fill="url(#shimmer)"/>

</svg>